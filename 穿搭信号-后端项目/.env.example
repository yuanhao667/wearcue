APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3456
OPENMETEO_URL=https://api.open-meteo.com/v1
OPENMETEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1
DATA_DIR=./data
MAX_UPLOAD_BYTES=5242880

# 逗号分隔；每个邀请码对应一个独立账号。生产环境必须显式配置。
INVITE_CODES=WC829GREEN,WC829BLUE

# OpenAI Schema 兼容视觉服务；Key 或主模型未配置时识别接口返回不可用
VISION_API_URL=https://api.inferera.com/v1
VISION_API_KEY=
VISION_MODEL=qwen3.8-flash
VISION_FALLBACK_MODEL=

# 文本任务路由：实时换一套、命名、详情建议走快速模型；系统预生成走质量模型
AI_API_URL=https://api.inferera.com/v1
AI_FAST_MODEL=qwen-turbo
AI_QUALITY_MODEL=qwen3.8-flash

# Web Push VAPID；三项齐全后才会真实发送
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
