APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3456
OPENMETEO_URL=https://api.open-meteo.com/v1
OPENMETEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1
DATA_DIR=./data
MAX_UPLOAD_BYTES=5242880

# 逗号分隔；每个邀请码对应一个独立账号。生产环境必须显式配置。
INVITE_CODES=WC829GREEN,WC829BLUE

# OpenAI Schema 兼容视觉服务；Key 留空时使用必须人工确认的 Mock Provider
VISION_API_URL=https://aihubmix.com/v1
VISION_API_KEY=
VISION_MODEL=qwen3.7-plus

# Web Push VAPID；三项齐全后才会真实发送
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
