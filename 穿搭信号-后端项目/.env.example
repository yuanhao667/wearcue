APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3456
OPENMETEO_URL=https://api.open-meteo.com/v1
OPENMETEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1
DATA_DIR=./data
# 线上指向 veFaaS 的 TOS 读写挂载目录；本地留空。
PERSISTENT_DATA_DIR=
MAX_UPLOAD_BYTES=5242880

# 逗号分隔；每个邀请码对应一个独立账号。生产环境必须显式配置。
INVITE_CODES=WC829GREEN,WC829BLUE

# 邮箱验证码。开发环境默认 console（接口会返回 dev_code）；生产环境使用 smtp。
# EMAIL_CODE_SECRET 请设置为至少 32 位随机字符串，修改后旧验证码会失效。
EMAIL_DELIVERY_MODE=
EMAIL_CODE_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
# Resend 正式发信配置（域名验证成功后使用）：
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USERNAME=resend
# SMTP_PASSWORD=<Resend 仅发送权限 API key；不要提交到版本库>
# SMTP_FROM=WearCue <noreply@mail.wearcue.cn>
# SMTP_USE_SSL=true
# SMTP_USE_STARTTLS=false
# EMAIL_DELIVERY_MODE=smtp

# 千问 AI 平台（OpenAI 兼容）。只需在 VISION_API_KEY 粘贴一个 Key，文字与视觉共用。
# 不设 AI_API_KEY 时，文字服务会自动复用 VISION_API_KEY。Key 获取：https://platform.qianwenai.com
VISION_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=qwen3.8-flash
VISION_FALLBACK_MODEL=qwen3-vl-plus

# 文本任务路由：实时换一套、命名、详情建议走快速模型；系统预生成走质量模型
AI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_FAST_MODEL=qwen-turbo
AI_QUALITY_MODEL=qwen3.8-flash
AI_REALTIME_TIMEOUT_SECONDS=30

# 生图：千问平台没有 OpenAI 格式的 /images/generations，必须走 DashScope 原生接口。
# AI_IMAGE_API_STYLE=openai 时用 POST {AI_IMAGE_API_URL}/images/generations；
# AI_IMAGE_API_STYLE=dashscope 时用 POST {AI_IMAGE_API_URL}/services/aigc/multimodal-generation/generation。
AI_IMAGE_API_URL=https://dashscope.aliyuncs.com/api/v1
AI_IMAGE_API_STYLE=dashscope
AI_IMAGE_MODEL=wan2.7-image

# TypeSafe JEV（System One）：首页“换一套”的图标判断首选。
# 只有填了 JEV_API_KEY 才会启用；未配置或调用失败时自动回退到 AI_FAST_MODEL。
# Key 在 console.typesafe.ai → Settings → Keys 创建；只写入本地 .env，不要提交。
JEV_API_URL=https://api.typesafe.ai/v1
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=8

# Web Push VAPID；三项齐全后才会真实发送
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
